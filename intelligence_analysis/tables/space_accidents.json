{
  "title": "事故案例库",
  "description": "独立事故案例模块：记录商业航天发射事故、地面测试事故、设施事故、发动机故障，含原因分析、调查信息与经验教训",
  "fields": [
    { "name": "id", "type": "string", "required": true, "description": "行 ID（写入方生成，32 位十六进制）" },
    { "name": "user_id", "type": "string", "required": true, "description": "写入者 uid（服务端注入）" },
    { "name": "created_at", "type": "time", "required": true },
    { "name": "updated_at", "type": "time", "required": true },
    { "name": "title", "type": "string", "description": "事故名称", "required": true },
    { "name": "incident_date", "type": "time", "description": "事故发生日期" },
    { "name": "location", "type": "string", "description": "事故地点（发射场/测试场/设施名）" },
    { "name": "company_name", "type": "string", "description": "涉事公司名称" },
    { "name": "company_id", "type": "string", "description": "关联 space_companies.id" },
    { "name": "vehicle", "type": "string", "description": "涉事火箭/飞行器型号" },
    { "name": "mission", "type": "string", "description": "任务名称" },
    { "name": "accident_type", "type": "string", "description": "事故类型", "required": true, "enum": ["飞行事故", "地面测试事故", "设施事故", "发动机测试"] },
    { "name": "severity", "type": "string", "description": "严重程度：致命/重大/较大/一般" },
    { "name": "phase", "type": "string", "description": "发生阶段：起飞/上升/级间分离/上面级/再入/着陆/静态点火/地面试车/压力测试等" },
    { "name": "casualties", "type": "string", "description": "人员伤亡情况" },
    { "name": "property_damage", "type": "text", "description": "设施/财产损失描述" },
    { "name": "description", "type": "text", "description": "事故经过详述" },
    { "name": "immediate_cause", "type": "text", "description": "直接原因" },
    { "name": "root_cause", "type": "text", "description": "根本原因" },
    { "name": "contributing_factors", "type": "text", "description": "促成因素" },
    { "name": "lessons_learned", "type": "text", "description": "经验教训" },
    { "name": "corrective_actions", "type": "text", "description": "整改措施/归零结论" },
    { "name": "investigation_body", "type": "string", "description": "调查机构（FAA/CENIPA/行业自查等）" },
    { "name": "investigation_status", "type": "string", "description": "调查状态：调查中/已结案/报告已发布" },
    { "name": "investigation_report_url", "type": "text", "description": "调查报告链接" },
    { "name": "related_company_ids", "type": "text", "description": "关联其他公司ID（逗号分隔）" },
    { "name": "related_regulation_ids", "type": "text", "description": "关联法规ID（指向 space_regulations）" },
    { "name": "related_accident_ids", "type": "text", "description": "关联事故ID（连锁事故）" },
    { "name": "source", "type": "string", "description": "信息来源" },
    { "name": "source_url", "type": "text", "description": "原文链接" },
    { "name": "tags", "type": "text", "description": "标签，逗号分隔" },
    { "name": "keywords", "type": "text", "description": "关键词，逗号分隔" },
    { "name": "lat", "type": "number", "title": "纬度", "description": "事故地点纬度（供地图标注）" },
    { "name": "lng", "type": "number", "title": "经度", "description": "事故地点经度（供地图标注）" }
  ],
  "indexes": [
    { "name": "idx_acc_incident_date", "fields": ["incident_date"] },
    { "name": "idx_acc_company", "fields": ["company_id"] },
    { "name": "idx_acc_type", "fields": ["accident_type"] },
    { "name": "idx_acc_severity", "fields": ["severity"] },
    { "name": "idx_acc_status", "fields": ["investigation_status"] },
    { "name": "idx_acc_vehicle", "fields": ["vehicle"] }
  ]
}

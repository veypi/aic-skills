SELECT id, title, incident_date, location, company_name, company_id, vehicle, mission, accident_type, severity, phase, casualties, property_damage, description, immediate_cause, root_cause, contributing_factors, lessons_learned, corrective_actions, investigation_body, investigation_status, investigation_report_url, related_company_ids, related_regulation_ids, related_accident_ids, source, source_url, tags, keywords, lat, lng
FROM space_accidents
WHERE id = :id

    { "id": "r3-desc", "type": "text", "x": 884, "y": 172, "w": 322, "h": 92, "html": "<b style=\"color:#fbbf24\">GitHub Copilot</b> — 最广 IDE 覆盖、多模型选择、Issue→PR 自动化。适合已深度绑定 GitHub 的团队。", "fontSize": 12.5, "color": "#94a3b8", "align": "left", "valign": "top", "lineHeight": 1.65, "group": "C", "fx": { "enter": "fade-up", "order": 3 } },

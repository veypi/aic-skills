    { "id": "q4-title", "type": "text", "x": 750, "y": 348, "w": 300, "h": 36, "html": "<b>云端自主代理</b>", "fontSize": 20, "fontWeight": 700, "color": "#f1f5f9", "align": "left", "valign": "middle", "group": "D", "fx": { "enter": "fade", "order": 4 } },

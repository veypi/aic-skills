{
  "schema": 1,
  "ui": {
    "pages": {
      "index": {
        "desc": "通过 H.264 流查看和控制设备主桌面"
      }
    }
  },
  "host": {
    "cua": {
      "run": ["bin/cua"],
      "protocol": "mcp",
      "idle_timeout": "30m"
    },
    "cua_cast": {
      "run": ["bin/cua_cast"],
      "idle_timeout": "30m",
      "streams": {
        "view": {
          "address_env": "CUA_STREAM_ADDR"
        }
      }
    }
  }
}
